# ==========================================
# Trema Job Search — Configuration Environnement
# ==========================================

# Flask
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=votre-cle-secrete-production
PORT=5001

# Supabase (Base de données & Stockage S3 des PDFs)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_KEY=votre-cle-service-role-ou-anon

# LLM Providers (Multi-provider Router avec bascule automatique)
GEMINI_API_KEY=votre-cle-api-gemini
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=votre-cle-api-groq
GROQ_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=votre-cle-api-mistral
MISTRAL_MODEL=mistral-small-latest

OPENROUTER_API_KEY=votre-cle-api-openrouter
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Notion CRM (Suivi automatisé des candidatures)
NOTION_TOKEN=ntn_votre_token_integration_notion
NOTION_DATABASE_ID=votre_id_database_notion_32_chars

# Seuils de Matching IA (sur 100)
MATCH_THRESHOLD_PRIORITY=85
MATCH_THRESHOLD_RECOMMENDED=75
MATCH_THRESHOLD_REVIEW=60

# Planificateur Quotidien
CRON_SCHEDULE_TIME=08:00
ENABLE_SCHEDULER=1

# Dossier local pour miroir des candidatures (PDFs)
LOCAL_STORAGE_DIR=/app/candidatures
